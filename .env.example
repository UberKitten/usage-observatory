# OpenAI Codex subscription usage only; this is not general ChatGPT message usage.
# Persistent directory containing usage.sqlite and the app-owned oauth.json.
USAGE_DATA_DIR=./data

# Collector cadence. Five minutes matches the upstream usage cache cadence.
COLLECT_INTERVAL_SECONDS=300
STALE_AFTER_SECONDS=900

# Optional defensive trigger for POST /api/admin/collect. Keep server-side only.
ADMIN_TOKEN=

# Disabled by default. If enabled, the earliest-expiring available reset is
# redeemed once only when it is near expiry and current usage makes it useful.
AUTO_REDEEM=false
AUTO_REDEEM_HORIZON_HOURS=12
